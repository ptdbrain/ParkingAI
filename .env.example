PARKING_APP_NAME=Edge AI Parking System
PARKING_ENVIRONMENT=development
PARKING_LOG_LEVEL=INFO
PARKING_INFERENCE_MODE=mock
PARKING_DATABASE_URL=sqlite+aiosqlite:///./edge_parking_demo.db
# Production MySQL example:
# PARKING_DATABASE_URL=mysql+asyncmy://parking_user:parking_pass@127.0.0.1:3306/parking
PARKING_QUEUE_MAX_SIZE=32
PARKING_FRAME_WIDTH=640
PARKING_FRAME_HEIGHT=360
PARKING_FRAME_RATE_LIMIT=5
YOLO_CONFIDENCE_THRESHOLD=0.35
FIRE_CONFIDENCE_THRESHOLD=0.40
OCR_CONFIDENCE_THRESHOLD=0.60
REID_MATCH_THRESHOLD=0.78
VLM_CONFIDENCE_THRESHOLD=0.50
REID_EMBEDDING_DIM=512
